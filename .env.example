# Copy this file to .env and fill in TELEGRAM_BOT_TOKEN at minimum.
# Every other value has a working default — only set what you want to change.

TELEGRAM_BOT_TOKEN=

DB_PATH=./data/mcafk.sqlite
LEGACY_JSON_PATH=./userdata.json

MAX_BOTS_GLOBAL=500
MAX_BOTS_PER_USER=10
MAX_FORWARDS_PER_USER=20
CHAT_STATE_TTL_MS=600000
CHAT_STATE_SWEEP_MS=300000

MAX_RECONNECTS=10
BASE_RECONNECT_MS=5000
MAX_RECONNECT_MS=60000
MC_TIMEOUT_MS=30000

FORWARD_BATCH_MS=1200
FORWARD_BATCH_MAX_LINES=20
FORWARD_BATCH_MAX_CHARS=3500

MC_DEFAULT_VERSION=1.20.4
MC_AUTH=offline
MC_HIDE_ERRORS=false
MC_VIEW_DISTANCE=tiny
MC_CHAT_LENGTH_LIMIT=100
MC_PHYSICS_ENABLED=true
MC_LOAD_INTERNAL_PLUGINS=true
MC_RESPAWN=true
